{
  "name": "homnayangi-server",
  "version": "0.1.0",
  "private": true,
  "description": "Web admin và REST API cho ứng dụng Hôm nay ăn gì?",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "migrate": "node scripts/migrate.js",
    "admin:create": "node scripts/create-admin.js",
    "seed:dev": "node scripts/seed-dev.js",
    "seed:legacy-foods": "node scripts/seed-legacy-foods.js",
    "ratings:recalculate": "node scripts/recalc-ratings.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "clearMocks": true
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "supertest": "7.3.1"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "bootstrap": "5.3.8",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "ejs": "7.0.2",
    "express": "5.3.0",
    "express-mysql-session": "3.0.3",
    "express-rate-limit": "8.7.3",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "mysql2": "3.24.6",
    "nodemailer": "10.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
