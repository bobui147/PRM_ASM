<%# Phân trang. Tham số: pager = { page, totalPages, total }. %>
<% if (pager.totalPages > 1) { %>
  <nav aria-label="Phân trang" class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-secondary small">Tổng <%= pager.total %> · Trang <%= pager.page %>/<%= pager.totalPages %></span>
    <ul class="pagination pagination-sm mb-0">
      <li class="page-item<%= pager.page <= 1 ? ' disabled' : '' %>"><a class="page-link" href="<%= pageUrl(pager.page - 1) %>">Trước</a></li>
      <li class="page-item<%= pager.page >= pager.totalPages ? ' disabled' : '' %>"><a class="page-link" href="<%= pageUrl(pager.page + 1) %>">Sau</a></li>
    </ul>
  </nav>
<% } else { %>
  <p class="text-secondary small mt-3 mb-0">Tổng <%= pager.total %></p>
<% } %>
