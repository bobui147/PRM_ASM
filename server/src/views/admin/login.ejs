<%- include('../partials/header') %>
<main id="main" class="container py-5">
  <div class="card shadow-sm mx-auto card-login">
    <div class="card-body p-4">
      <h1 class="h4 mb-3">Đăng nhập quản trị</h1>
      <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
      <form method="post" action="/admin/login" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrf() %>" />
        <input type="hidden" name="next" value="<%= next %>" />
        <div class="mb-3">
          <label class="form-label" for="login">Username hoặc email</label>
          <input class="form-control" id="login" name="login" value="<%= login %>" autocomplete="username" required autofocus />
        </div>
        <div class="mb-3">
          <label class="form-label" for="password">Mật khẩu</label>
          <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required />
        </div>
        <button class="btn btn-primary w-100" type="submit">Đăng nhập</button>
      </form>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
