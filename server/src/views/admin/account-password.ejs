<%- include('../partials/header') %>
<main id="main" class="container py-4">
  <h1 class="h4 mb-3">Đổi mật khẩu</h1>
  <form method="post" action="/admin/account/password" class="card card-body card-narrow" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrf() %>" />
    <%- include('../partials/field', { name: 'currentPassword', label: 'Mật khẩu hiện tại', value: '', type: 'password', required: true }) %>
    <%- include('../partials/field', { name: 'newPassword', label: 'Mật khẩu mới', value: '', type: 'password', required: true, help: 'Ít nhất 12 ký tự, có chữ và số.' }) %>
    <%- include('../partials/field', { name: 'confirmPassword', label: 'Nhập lại mật khẩu mới', value: '', type: 'password', required: true }) %>
    <button class="btn btn-primary" type="submit">Lưu</button>
  </form>
</main>
<%- include('../partials/footer') %>
