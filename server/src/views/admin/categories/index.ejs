<%- include('../../partials/header') %>
<main id="main" class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Nhóm món</h1>
    <a class="btn btn-primary" href="/admin/categories/new">Thêm nhóm</a>
  </div>
  <%- include('../../partials/flash') %>
  <div class="table-responsive bg-white border rounded">
    <table class="table table-hover align-middle mb-0">
      <thead><tr><th>Thứ tự</th><th>Tên</th><th>Mã</th><th>Icon</th><th>Dùng bữa ăn</th><th>Số món</th><th>Trạng thái</th><th></th></tr></thead>
      <tbody>
        <% for (const row of rows) { %>
          <tr>
            <td><%= row.sort_order %></td>
            <td><%= row.name %></td>
            <td><code><%= row.slug %></code></td>
            <td><%= row.icon %></td>
            <td><%= row.uses_meal_periods ? 'Có' : 'Không' %></td>
            <td><%= row.food_count %></td>
            <td><span class="badge text-bg-<%= row.status === 'active' ? 'success' : 'secondary' %>"><%= row.status === 'active' ? 'Hiển thị' : 'Ẩn' %></span></td>
            <td class="text-end text-nowrap">
              <a class="btn btn-sm btn-outline-primary" href="/admin/categories/<%= row.id %>/edit">Sửa</a>
              <form method="post" action="/admin/categories/<%= row.id %>/delete" class="d-inline" data-confirm="Xóa nhóm &quot;<%= row.name %>&quot;?">
                <input type="hidden" name="_csrf" value="<%= csrf() %>" />
                <button class="btn btn-sm btn-outline-danger" type="submit"<%= row.food_count > 0 ? ' disabled title=Còn món trong nhóm' : '' %>>Xóa</button>
              </form>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</main>
<%- include('../../partials/footer') %>
