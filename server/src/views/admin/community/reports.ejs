<%- include('../../partials/header') %>
<main id="main" class="container-fluid py-4">
  <h1 class="h4 mb-3"><%= title %></h1>
  <%- include('../../partials/flash') %>
  <form method="get" class="row g-2 mb-3 bg-white border rounded p-3">
    <div class="col-md-3"><label class="form-label small" for="q-type">Loại nội dung</label>
      <select class="form-select form-select-sm" id="q-type" name="type">
        <option value="">Tất cả</option>
        <option value="post"<%= type === 'post' ? ' selected' : '' %>>Bài viết</option>
        <option value="comment"<%= type === 'comment' ? ' selected' : '' %>>Bình luận</option>
      </select></div>
    <div class="col-md-3"><label class="form-label small" for="q-status">Trạng thái báo cáo</label>
      <select class="form-select form-select-sm" id="q-status" name="status">
        <option value="open"<%= status === 'open' ? ' selected' : '' %>>Đang mở</option>
        <option value="resolved"<%= status === 'resolved' ? ' selected' : '' %>>Đã xử lý</option>
        <option value="dismissed"<%= status === 'dismissed' ? ' selected' : '' %>>Đã bỏ qua</option>
      </select></div>
    <div class="col-md-3 d-flex align-items-end"><button class="btn btn-sm btn-primary" type="submit">Lọc</button></div>
  </form>
  <% if (items.length === 0) { %><p class="text-secondary">Không có báo cáo nào.</p><% } %>
  <% for (const item of items) { %>
    <% const label = item.type === 'post' ? 'Bài' : 'Bình luận'; const key = item.type + '-' + item.id; %>
    <article class="bg-white border rounded p-3 mb-3<%= item.reports.length >= 3 ? ' border-danger' : '' %>">
      <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
        <div>
          <strong><%= label %> #<%= item.id %></strong>
          <% if (item.type === 'comment' && item.target) { %>· trong <a href="/admin/community/comments?post=<%= item.target.post_id %>">bài #<%= item.target.post_id %></a><% } %>
          · <span class="badge text-bg-danger"><%= item.reports.length %> báo cáo</span>
          <% if (item.target) { %>· <span class="badge <%= item.target.status === 'hidden' ? 'text-bg-warning' : 'text-bg-success' %>"><%= item.target.status === 'hidden' ? 'Đã ẩn' : 'Đang hiển thị' %></span><% } %>
        </div>
        <% if (item.target) { %><div class="small">Tác giả: <a href="/admin/users/<%= item.target.user_id %>"><%= item.target.display_name %></a> (<%= item.target.email %>) · <%= fmtDate(item.target.created_at) %></div><% } %>
      </div>
      <% if (!item.target) { %>
        <p class="text-secondary">Nội dung đã bị xóa.</p>
      <% } else { %>
        <% if (item.target.content) { %><p class="pre-line mb-2"><%= item.target.content %></p><% } %>
        <% if (item.target.images.length > 0) { %>
          <div class="d-flex gap-2 mb-2"><% for (const img of item.target.images) { %><a href="<%= img.url %>" target="_blank" rel="noopener"><img class="thumb" src="<%= img.thumbUrl %>" alt="Ảnh bài viết" /></a><% } %></div>
        <% } %>
      <% } %>
      <ul class="small mb-3">
        <% for (const rp of item.reports) { %>
          <li><a href="/admin/users/<%= rp.reporter_id %>"><%= rp.display_name %></a>: <strong><%= labels.REPORT_REASON_LABELS[rp.reason] %></strong><%= rp.details ? ' · ' + rp.details : '' %> <span class="text-secondary">(<%= fmtDate(rp.created_at) %>)</span></li>
        <% } %>
      </ul>
      <% if (status === 'open' && item.target) { %>
        <div class="d-flex flex-wrap gap-2 align-items-end border-top pt-2">
          <form method="post" action="/admin/community/reports/<%= item.type %>/<%= item.id %>/hide" class="d-flex flex-wrap gap-2 align-items-end">
            <input type="hidden" name="_csrf" value="<%= csrf() %>" />
            <div class="form-check"><input class="form-check-input" type="checkbox" id="cb-<%= key %>" name="block" /><label class="form-check-label small" for="cb-<%= key %>">Khóa tác giả</label></div>
            <label class="visually-hidden" for="cd-<%= key %>">Thời hạn</label>
            <select class="form-select form-select-sm w-auto" id="cd-<%= key %>" name="duration">
              <% for (const [dkey, dlabel] of Object.entries(durations)) { %><option value="<%= dkey %>"<%= dkey === '7' ? ' selected' : '' %>><%= dlabel %></option><% } %>
            </select>
            <button class="btn btn-sm btn-danger" type="submit">Ẩn <%= label.toLowerCase() %></button>
          </form>
          <form method="post" action="/admin/community/reports/<%= item.type %>/<%= item.id %>/dismiss">
            <input type="hidden" name="_csrf" value="<%= csrf() %>" />
            <button class="btn btn-sm btn-outline-secondary" type="submit">Bỏ qua báo cáo</button>
          </form>
        </div>
      <% } %>
    </article>
  <% } %>
  <%- include('../../partials/pagination', { pager }) %>
</main>
<%- include('../../partials/footer') %>
