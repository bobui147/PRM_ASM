<%- include('../../partials/header') %>
<main id="main" class="container-fluid py-4">
  <h1 class="h4 mb-3"><%= title %></h1>
  <%- include('../../partials/flash') %>
  <form method="get" class="row g-2 mb-3 bg-white border rounded p-3">
    <div class="col-md-3"><label class="form-label small" for="q-status">Trạng thái</label>
      <select class="form-select form-select-sm" id="q-status" name="status">
        <option value="">Tất cả</option>
        <% for (const [key, label] of Object.entries(statusLabels)) { %><option value="<%= key %>"<%= query.status === key ? ' selected' : '' %>><%= label %></option><% } %>
      </select></div>
    <div class="col-md-4"><label class="form-label small" for="q-text">Tìm nội dung hoặc tác giả</label>
      <input class="form-control form-control-sm" id="q-text" name="q" maxlength="100" value="<%= query.q %>" /></div>
    <div class="col-md-2 d-flex align-items-end"><div class="form-check"><input class="form-check-input" type="checkbox" id="q-reported" name="reported" value="1"<%= query.reported ? ' checked' : '' %> /><label class="form-check-label small" for="q-reported">Đang bị báo cáo</label></div></div>
    <% if (query.userId) { %><input type="hidden" name="user" value="<%= query.userId %>" /><% } %>
    <div class="col-md-3 d-flex align-items-end gap-2"><button class="btn btn-sm btn-primary" type="submit">Lọc</button><a class="btn btn-sm btn-outline-secondary" href="/admin/community/posts">Bỏ lọc</a></div>
  </form>
  <% if (items.length === 0) { %><p class="text-secondary">Không có bài nào.</p><% } %>
  <% for (const item of items) { %>
    <article class="bg-white border rounded p-3 mb-3<%= item.status === 'hidden' ? ' border-warning' : '' %>" id="post-<%= item.id %>">
      <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
        <div>
          <strong>Bài #<%= item.id %></strong>
          · <span class="badge <%= item.status === 'hidden' ? 'text-bg-warning' : 'text-bg-success' %>"><%= statusLabels[item.status] %></span>
          <% if (item.openReports > 0) { %>· <a class="badge text-bg-danger text-decoration-none" href="/admin/community/reports?type=post"><%= item.openReports %> báo cáo</a><% } %>
          · <%= item.likeCount %> thích · <a href="/admin/community/comments?post=<%= item.id %>"><%= item.commentCount %> bình luận</a>
        </div>
        <div class="small">Tác giả: <a href="/admin/users/<%= item.author.id %>"><%= item.author.displayName %></a> (<%= item.authorEmail %>) · <%= fmtDate(item.createdAt) %><%= item.edited ? ' · đã sửa' : '' %></div>
      </div>
      <% if (item.food || item.restaurant) { %>
        <p class="small text-secondary mb-1">
          <% if (item.food) { %>Món: <%= item.food.name %><%= item.food.id ? '' : ' (không còn công khai)' %><% } %>
          <% if (item.food && item.restaurant) { %> · <% } %>
          <% if (item.restaurant) { %>Quán: <%= item.restaurant.name %><%= item.restaurant.id ? '' : ' (không còn công khai)' %><% } %>
        </p>
      <% } %>
      <% if (item.content) { %><p class="pre-line mb-2"><%= item.content %></p><% } %>
      <% if (item.images.length > 0) { %>
        <div class="d-flex gap-2 mb-2"><% for (const img of item.images) { %><a href="<%= img.url %>" target="_blank" rel="noopener"><img class="thumb" src="<%= img.thumbUrl %>" alt="Ảnh bài viết" /></a><% } %></div>
      <% } %>
      <% if (item.moderationNote) { %><p class="small text-warning-emphasis mb-2">Ghi chú kiểm duyệt: <%= item.moderationNote %></p><% } %>
      <div class="d-flex flex-wrap gap-2 align-items-end border-top pt-2">
        <% if (item.status === 'visible') { %>
          <form method="post" action="/admin/community/posts/<%= item.id %>/hide" class="d-flex gap-2 align-items-end">
            <input type="hidden" name="_csrf" value="<%= csrf() %>" />
            <input type="hidden" name="back" value="<%= back %>" />
            <label class="visually-hidden" for="note-<%= item.id %>">Ghi chú</label>
            <input class="form-control form-control-sm w-auto" id="note-<%= item.id %>" name="note" maxlength="300" placeholder="Ghi chú (tác giả thấy được)" />
            <button class="btn btn-sm btn-warning" type="submit">Ẩn bài</button>
          </form>
        <% } else { %>
          <form method="post" action="/admin/community/posts/<%= item.id %>/unhide">
            <input type="hidden" name="_csrf" value="<%= csrf() %>" />
            <input type="hidden" name="back" value="<%= back %>" />
            <button class="btn btn-sm btn-outline-success" type="submit">Hiện lại</button>
          </form>
        <% } %>
        <form method="post" action="/admin/community/posts/<%= item.id %>/delete" data-confirm="Xóa vĩnh viễn bài #<%= item.id %> kèm ảnh, bình luận và lượt thích?">
          <input type="hidden" name="_csrf" value="<%= csrf() %>" />
          <input type="hidden" name="back" value="<%= back %>" />
          <button class="btn btn-sm btn-outline-danger" type="submit">Xóa vĩnh viễn</button>
        </form>
      </div>
    </article>
  <% } %>
  <%- include('../../partials/pagination', { pager }) %>
</main>
<%- include('../../partials/footer') %>
