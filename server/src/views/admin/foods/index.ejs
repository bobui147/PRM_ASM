<%- include('../../partials/header') %>
<main id="main" class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Món ăn</h1>
    <a class="btn btn-primary" href="/admin/foods/new">Thêm món</a>
  </div>
  <%- include('../../partials/flash') %>
  <form method="get" class="row g-2 mb-3" role="search">
    <div class="col-md-4">
      <label class="visually-hidden" for="q">Tìm theo tên</label>
      <input class="form-control" id="q" name="q" placeholder="Tìm theo tên món" value="<%= query.q %>" />
    </div>
    <div class="col-md-3">
      <label class="visually-hidden" for="category">Nhóm món</label>
      <select class="form-select" id="category" name="category">
        <option value="">Tất cả nhóm</option>
        <% for (const c of categories) { %>
          <option value="<%= c.id %>"<%= query.categoryId === c.id ? ' selected' : '' %>><%= c.name %></option>
        <% } %>
      </select>
    </div>
    <div class="col-md-3">
      <label class="visually-hidden" for="status">Trạng thái</label>
      <select class="form-select" id="status" name="status">
        <option value="">Mọi trạng thái</option>
        <option value="active"<%= query.status === 'active' ? ' selected' : '' %>>Hiển thị</option>
        <option value="hidden"<%= query.status === 'hidden' ? ' selected' : '' %>>Ẩn</option>
      </select>
    </div>
    <div class="col-md-2"><button class="btn btn-outline-secondary w-100" type="submit">Lọc</button></div>
  </form>
  <div class="table-responsive bg-white border rounded">
    <table class="table table-hover align-middle mb-0">
      <thead><tr><th>Ảnh</th><th>Tên</th><th>Nhóm</th><th>Giá tham khảo</th><th>Độ hiếm</th><th>Số quán</th><th>Trạng thái</th><th></th></tr></thead>
      <tbody>
        <% if (rows.length === 0) { %><tr><td colspan="8" class="text-center text-secondary py-4">Chưa có món nào.</td></tr><% } %>
        <% for (const row of rows) { %>
          <tr>
            <td><% if (row.thumb_path) { %><img class="thumb" src="<%= uploadUrl(row.thumb_path) %>" alt="" /><% } else { %><span class="text-secondary small">Không ảnh</span><% } %></td>
            <td><%= row.name %></td>
            <td><%= row.category_name %></td>
            <td><%= fmtMoney(row.reference_price) %></td>
            <td><%= labels.RARITY_LABELS[row.rarity] %></td>
            <td><%= row.restaurant_count %></td>
            <td><span class="badge text-bg-<%= row.status === 'active' ? 'success' : 'secondary' %>"><%= row.status === 'active' ? 'Hiển thị' : 'Ẩn' %></span></td>
            <td class="text-end text-nowrap">
              <a class="btn btn-sm btn-outline-primary" href="/admin/foods/<%= row.id %>/edit">Sửa</a>
              <form method="post" action="/admin/foods/<%= row.id %>/delete" class="d-inline" data-confirm="Xóa món &quot;<%= row.name %>&quot;? Món sẽ bị gỡ khỏi thực đơn của mọi quán.">
                <input type="hidden" name="_csrf" value="<%= csrf() %>" />
                <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
              </form>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <%- include('../../partials/pagination', { pager }) %>
</main>
<%- include('../../partials/footer') %>
