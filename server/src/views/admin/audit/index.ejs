<%- include('../../partials/header') %>
<main id="main" class="container-fluid py-4">
  <h1 class="h4 mb-3"><%= title %></h1>
  <form method="get" class="row g-2 mb-3 bg-white border rounded p-3">
    <div class="col-md-3"><label class="form-label small" for="a-admin">Admin</label>
      <select class="form-select form-select-sm" id="a-admin" name="admin"><option value="">Tất cả</option>
        <% for (const a of admins) { %><option value="<%= a.id %>"<%= query.adminId === a.id ? ' selected' : '' %>><%= a.username %></option><% } %>
      </select></div>
    <div class="col-md-3"><label class="form-label small" for="a-action">Thao tác (ví dụ review, user.block)</label>
      <input class="form-control form-control-sm" id="a-action" name="action" value="<%= query.action || '' %>" /></div>
    <div class="col-md-2"><label class="form-label small" for="a-from">Từ ngày</label><input class="form-control form-control-sm" id="a-from" type="date" name="from" value="<%= query.from || '' %>" /></div>
    <div class="col-md-2"><label class="form-label small" for="a-to">Đến ngày</label><input class="form-control form-control-sm" id="a-to" type="date" name="to" value="<%= query.to || '' %>" /></div>
    <div class="col-md-2 d-flex align-items-end gap-2"><button class="btn btn-sm btn-primary" type="submit">Lọc</button><a class="btn btn-sm btn-outline-secondary" href="/admin/audit-logs">Bỏ lọc</a></div>
  </form>
  <div class="table-responsive bg-white border rounded">
    <table class="table table-sm align-middle mb-0">
      <thead><tr><th>Thời điểm</th><th>Admin</th><th>Thao tác</th><th>Đối tượng</th><th>Nội dung</th><th>IP</th></tr></thead>
      <tbody>
        <% if (rows.length === 0) { %><tr><td colspan="6" class="text-secondary">Chưa có nhật ký.</td></tr><% } %>
        <% for (const row of rows) { %>
          <tr>
            <td class="text-nowrap"><%= fmtDate(row.created_at) %></td>
            <td><%= row.username || '(đã xóa)' %></td>
            <td><code><%= row.action %></code></td>
            <td><%= row.target_type %><%= row.target_id ? ' #' + row.target_id : '' %></td>
            <td><%= row.summary %></td>
            <td class="small text-secondary"><%= row.ip %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <%- include('../../partials/pagination', { pager }) %>
</main>
<%- include('../../partials/footer') %>
