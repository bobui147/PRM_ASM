<%- include('../../partials/header') %>
<main id="main" class="container-fluid py-4">
  <h1 class="h4 mb-3"><%= title %></h1>
  <%- include('../../partials/flash') %>
  <form method="get" class="row g-2 mb-3 bg-white border rounded p-3">
    <div class="col-md-5"><label class="form-label small" for="u-q">Email hoặc tên</label><input class="form-control form-control-sm" id="u-q" name="q" value="<%= query.q %>" /></div>
    <div class="col-md-3"><label class="form-label small" for="u-status">Trạng thái</label>
      <select class="form-select form-select-sm" id="u-status" name="status">
        <option value="">Tất cả</option>
        <option value="unverified"<%= query.status === 'unverified' ? ' selected' : '' %>>Chưa xác minh</option>
        <option value="active"<%= query.status === 'active' ? ' selected' : '' %>>Hoạt động</option>
        <option value="blocked"<%= query.status === 'blocked' ? ' selected' : '' %>>Bị khóa</option>
      </select></div>
    <div class="col-md-4 d-flex align-items-end gap-2"><button class="btn btn-sm btn-primary" type="submit">Lọc</button><a class="btn btn-sm btn-outline-secondary" href="/admin/users">Bỏ lọc</a></div>
  </form>
  <div class="table-responsive bg-white border rounded">
    <table class="table table-hover align-middle mb-0">
      <thead><tr><th>Tên</th><th>Email</th><th>Trạng thái</th><th>Review</th><th>Ngày tạo</th></tr></thead>
      <tbody>
        <% if (rows.length === 0) { %><tr><td colspan="5" class="text-secondary">Không có người dùng.</td></tr><% } %>
        <% for (const u of rows) { %>
          <tr>
            <td><a href="/admin/users/<%= u.id %>"><%= u.display_name %></a><% if (u.spam_count >= 3) { %> <span class="badge text-bg-danger">Nghi spam</span><% } %></td>
            <td><%= u.email %></td>
            <td>
              <% if (isBlocked(u)) { %><span class="badge text-bg-danger">Bị khóa</span>
              <% } else if (!u.email_verified_at) { %><span class="badge text-bg-warning">Chưa xác minh</span>
              <% } else { %><span class="badge text-bg-success">Hoạt động</span><% } %>
            </td>
            <td><%= u.review_count %></td>
            <td class="text-nowrap"><%= fmtDate(u.created_at) %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <%- include('../../partials/pagination', { pager }) %>
</main>
<%- include('../../partials/footer') %>
