<%- include('../../partials/header') %>
<main id="main" class="container-fluid py-4">
  <h1 class="h4 mb-3"><%= title %></h1>
  <%- include('../../partials/flash') %>
  <form method="get" class="row g-2 mb-3 bg-white border rounded p-3">
    <div class="col-md-3"><label class="form-label small" for="q-phase">Trạng thái</label>
      <select class="form-select form-select-sm" id="q-phase" name="phase">
        <option value="">Tất cả</option>
        <% for (const [key, label] of Object.entries(phaseLabels)) { %><option value="<%= key %>"<%= phase === key ? ' selected' : '' %>><%= label %></option><% } %>
      </select></div>
    <div class="col-md-3 d-flex align-items-end"><button class="btn btn-sm btn-primary" type="submit">Lọc</button></div>
  </form>
  <% if (items.length === 0) { %><p class="text-secondary">Chưa có phòng nào.</p><% } else { %>
  <div class="table-responsive bg-white border rounded">
    <table class="table table-sm align-middle mb-0">
      <thead><tr><th>#</th><th>Mã</th><th>Chủ phòng</th><th>Bộ lọc</th><th>Thành viên</th><th>Trạng thái</th><th>Kết quả</th><th>Tạo lúc</th><th></th></tr></thead>
      <tbody>
        <% for (const r of items) { %>
          <tr>
            <td><%= r.id %></td>
            <td><code><%= r.code %></code></td>
            <td><a href="/admin/users/<%= r.owner_id %>"><%= r.owner_name %></a></td>
            <td class="small"><%= r.category_name || 'Mọi nhóm' %><%= r.max_price ? ' · tối đa ' + fmtMoney(r.max_price) : '' %></td>
            <td><%= r.member_count %></td>
            <td><%= phaseLabels[r.phase] %><% if (r.closed_reason) { %><div class="small text-secondary"><%= closedLabels[r.closed_reason] %></div><% } %></td>
            <td><%= r.result_food_name || '' %><% if (r.result_method) { %><div class="small text-secondary"><%= r.result_method === 'spin' ? 'Quay' : r.result_method === 'tie_spin' ? 'Hòa phiếu, quay ngẫu nhiên' : 'Bỏ phiếu' %></div><% } %></td>
            <td class="small text-nowrap"><%= fmtDate(r.created_at) %></td>
            <td>
              <% if (r.phase !== 'closed') { %>
                <form method="post" action="/admin/rooms/<%= r.id %>/close" data-confirm="Đóng phòng <%= r.code %>? Mọi thành viên sẽ thấy phòng đã kết thúc.">
                  <input type="hidden" name="_csrf" value="<%= csrf() %>" />
                  <button class="btn btn-sm btn-outline-danger" type="submit">Đóng phòng</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
  <%- include('../../partials/pagination', { pager }) %>
</main>
<%- include('../../partials/footer') %>
